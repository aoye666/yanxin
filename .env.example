# 研心 / YanXin —— docker compose 的取值（复制成 .env 再填）
#
#   cp .env.example .env && docker compose up -d
#
# ⚠️ `.env` 已被 .gitignore 挡着（`.env.*` 那一条），别把它提交、也别贴进 issue。
# ⚠️ 这里的值会变成容器里的进程环境变量 —— `docker inspect` 与编排系统都看得见。
#    真正需要长期保管的只有 LLM_API_KEY 与那两个 token。

# ── 必填：LLM 路由（任意 OpenAI 兼容网关）──────────────────────────────────
# ⚠️ 模型必须**支持 function calling**：世界引擎靠 `tool_choice: required` 提案，
#    不支持的模型会安静地什么都不做。
# ⚠️ 模型 id 必须是这条网关上**真实存在**的那个：写错时 ReMe 的 auto_memory 回 404，
#    而 HTTP 状态码仍然是 200（静默失败，spec 附录 A）。
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL_NAME=replace-me-with-a-real-model-id

# ── 强烈建议：她的 QQ 号与 OneBot 的 access token ───────────────────────────
# 反向 WS 由 NapCat / SnowLuma 连到本机的 8080（它不在镜像里）。
#
# · 监听地址默认 0.0.0.0（宿主机要连得进来），所以**没有 token 就不让起** ——
#   entrypoint 那道门在生成之前：非回环 + token 空 → 直接 `exit 1`（`docker/entrypoint.mjs:57-65`），
#   不是警告。那条端口上没有别的东西在守，token 一空，任何连得上的人都能冒充她的客户端。
# · **只有**把 YANXIN_ONEBOT_HOST 收成 127.0.0.1 时，留空才会走"随机生成一个并只打印一次"
#   （打在第一行容器日志里），NapCat 的「鉴权 Token」填同一个值。
YANXIN_SELF_ID=
YANXIN_ONEBOT_TOKEN=

# ── 控制台凭据（写操作与实时日志流都要）────────────────────────────────────
# 不填 = 一律 403 拒写拒流（fail-closed），她照常说话、页面照常能看。
# ⚠️ 这一版镜像把控制台放成了**远程可达**，而这个 token 是唯一的门：
#    公网直连前先读 README 的安全一节（会话凭据是下一轮要补的东西）。
YANXIN_CONSOLE_TOKEN=

# ── 可忽略：绑地址与端口（默认值就是镜像的设计值）───────────────────────────
# 只想让本机访问就设成 127.0.0.1 —— entrypoint 会相应地不再放宽控制台的远程门。
# YANXIN_WEB_HOST=0.0.0.0
# YANXIN_ONEBOT_HOST=0.0.0.0
# YANXIN_WEB_PORT=3080
# YANXIN_ONEBOT_PORT=8080
